# Phase 8H prospective collector — example only
# NEVER commit real credentials or database URLs.

COLLECTOR_MODE=PREFLIGHT
PAPER_TRADE=true
LIVE_TRADING_CONFIRMED=
NEXUS_PILOT_ENABLED=false

DB_AUTHORITY=BGX_RESEARCH_PROSPECTIVE_ALPHA_V1
EXPECTED_CONTRACT_SHA256=d28ad750e49dc183650cb4e65460d7632666022e38e2f2cfef89aca1dc9a46a7

# Must point to a NEW dedicated research database on the future hosting account.
PROSPECTIVE_DB_URL=__SET_IN_HOST_SECRET_MANAGER__

# Set only to the new production DB fingerprint once known.
# Never copy a production DB URL into the collector.
PRODUCTION_DB_FINGERPRINT=__SET_AFTER_NEW_PRODUCTION_IS_CREATED__

# Keep false until dedicated persistent storage has been provisioned and verified.
PROSPECTIVE_STORAGE_READY=false

# PREFLIGHT soak duration in seconds.
PREFLIGHT_WS_SECONDS=14400

# DO NOT set these until a separate explicit T0 authorization is given.
# PROSPECTIVE_T0_AUTHORIZATION=
# PROSPECTIVE_T0_MS=
